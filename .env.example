# TypeNull Environment Variables Example
# Duplicate this file as .env for local development once Supabase credentials are configured in Phase 2.
#
# IMPORTANT SECURITY NOTICE:
# Only client-safe, public variables prefixed with VITE_ are included here.
# NEVER place service_role keys, secret API keys, or database passwords in frontend environment files.

# Supabase Project URL (e.g., https://your-project-ref.supabase.co)
VITE_SUPABASE_URL=

# Supabase Publishable / Anon Client Key (e.g., sb_publishable_... or your project's anon key)
VITE_SUPABASE_PUBLISHABLE_KEY=
